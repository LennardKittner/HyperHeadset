#!/usr/bin/env bash
# Local cross-platform verification before submitting a PR: compile, link,
# test, and format checks that don't need multi-OS hardware.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

usage() {
    cat << 'EOF'
Usage: ./preflight [options]

Catches, before a PR goes out, what building on one OS by hand does not:

  - cargo check for every feature combination, plus a full-feature build and
    cargo test, natively and cross-compiled for x86_64-pc-windows-gnu. Link
    errors don't surface in a plain check, warnings are promoted to errors
    (-D warnings), and --locked catches Cargo.lock drift.
  - the windows-gnu half is skipped, with install instructions, when the
    target or a mingw-w64 toolchain is missing.
  - rustfmt --check, scoped to the lines this branch changed (see --base), so
    the repo's pre-existing format drift stays out of the way. A failure
    prints the offending lines with rustfmt's diff for them and offers to
    apply and stage just those fixes.
  - a gate on added dbg!/todo!/unimplemented! lines (see --allow-debug).
  - a reminder to hand-trace changed shell/cmd.exe/AppleScript strings — a
    clean compile says nothing about argv quoting.
  - with --remote, the real 3-OS CI run that no local check can substitute.

Exits non-zero if any check fails.

  --base <ref>      Diff base used to scope the rustfmt check and the
                    debug-macro/interpreter-string greps to what this branch
                    actually changed. Default: this branch's upstream, else
                    merge-base with upstream/dev, origin/dev, or origin/main
                    (first that exists), else HEAD~1.
  --skip-rustfmt    Don't run the rustfmt check at all.
  --apply-rustfmt   Apply and stage the rustfmt fixes without asking (and
                    without needing a terminal). Same guards as the prompt:
                    the staging area must be empty and the flagged files
                    unmodified. The check still fails — HEAD is unchanged.
  --remote          Real 3-OS validation on GitHub Actions — locally, other
                    OSes are at best cross-compiled, never run. Pushes HEAD
                    to a temporary origin branch (preflight/<short-sha>) for
                    CI to build, watches the run, then deletes it. Requires
                    gh.
  --keep-branch     Don't delete the temporary --remote branch afterwards.
  --allow-debug     Don't fail on added dbg!/todo!/unimplemented! lines.
  -h, --help        Show this help.
EOF
}

BASE_REF=""
DO_REMOTE=0
KEEP_BRANCH=0
ALLOW_DEBUG=0
SKIP_RUSTFMT=0
APPLY_RUSTFMT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
    --base)
        BASE_REF="$2"
        shift 2
        ;;
    --skip-rustfmt)
        SKIP_RUSTFMT=1
        shift
        ;;
    --apply-rustfmt)
        APPLY_RUSTFMT=1
        shift
        ;;
    --remote)
        DO_REMOTE=1
        shift
        ;;
    --keep-branch)
        KEEP_BRANCH=1
        shift
        ;;
    --allow-debug)
        ALLOW_DEBUG=1
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo "Unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
done

if [[ $SKIP_RUSTFMT -eq 1 && $APPLY_RUSTFMT -eq 1 ]]; then
    echo "--skip-rustfmt and --apply-rustfmt are mutually exclusive." >&2
    exit 1
fi

if [[ -z $BASE_REF ]]; then
    # Prefer "what hasn't been pushed yet" (this branch's own remote-tracking
    # ref) — that's the actual preflight question. Only fall back to a shared
    # base branch for a never-pushed branch, since that pulls in the whole
    # branch history (including pre-existing drift it didn't introduce)
    # rather than just what's new since the last push.
    BASE_REF=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2> /dev/null ||
        git merge-base HEAD upstream/dev 2> /dev/null ||
        git merge-base HEAD origin/dev 2> /dev/null ||
        git merge-base HEAD origin/main 2> /dev/null ||
        git rev-parse HEAD~1)
fi

FEATURE_SETS=("" "eq-support" "eq-editor")
FULL_FEATURES="eq-editor"
WINDOWS_TARGET="x86_64-pc-windows-gnu"
EDITION=$(sed -n 's/^edition *= *"\([0-9][0-9]*\)".*/\1/p' Cargo.toml | head -n 1)
EDITION=${EDITION:-2021}
LOG_DIR="${TMPDIR:-/tmp}"

PASS=1
SUMMARY=""

note() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }
ok() { SUMMARY="${SUMMARY}  OK    $1"$'\n'; }
fail() {
    SUMMARY="${SUMMARY}  FAIL  $1"$'\n'
    PASS=0
}
skip() { SUMMARY="${SUMMARY}  SKIP  $1"$'\n'; }

# run_cargo <label> <log-name> <cargo args...>
# RUSTFLAGS="-D warnings" promotes warnings to errors so cargo check/build
# exit non-zero on warnings (e.g. unused_mut) that would otherwise be silent.
run_cargo() {
    local label="$1" log="$LOG_DIR/preflight-$2.log"
    shift 2
    if RUSTFLAGS="${RUSTFLAGS:-} -D warnings" cargo "$@" --locked > "$log" 2>&1; then
        ok "$label"
    else
        fail "$label (see $log)"
    fi
}

note "Base ref: $BASE_REF"

note "Native cargo check"
for feat in "${FEATURE_SETS[@]}"; do
    if [[ -z $feat ]]; then
        run_cargo "native check" "check-native-default" check
    else
        run_cargo "native check --features $feat" "check-native-$feat" \
            check --features "$feat"
    fi
done

note "Native cargo build + test"
run_cargo "native build --features $FULL_FEATURES" "build-native" \
    build --features "$FULL_FEATURES"
run_cargo "native test" "test-native-default" test
run_cargo "native test --features $FULL_FEATURES" "test-native-full" \
    test --features "$FULL_FEATURES"

note "Windows ($WINDOWS_TARGET) cargo check + build"
if [[ "$(rustc -vV | sed -n 's/^host: //p')" == *windows* ]]; then
    skip "windows cross-check (already building natively on Windows)"
elif rustup target list --installed 2> /dev/null | grep -q "^${WINDOWS_TARGET}$" &&
    command -v x86_64-w64-mingw32-gcc > /dev/null 2>&1; then
    for feat in "${FEATURE_SETS[@]}"; do
        if [[ -z $feat ]]; then
            run_cargo "windows-gnu check" "check-windows-default" \
                check --target "$WINDOWS_TARGET"
        else
            run_cargo "windows-gnu check --features $feat" "check-windows-$feat" \
                check --target "$WINDOWS_TARGET" --features "$feat"
        fi
    done
    run_cargo "windows-gnu build --features $FULL_FEATURES" "build-windows" \
        build --target "$WINDOWS_TARGET" --features "$FULL_FEATURES"
else
    skip "windows-gnu cross-check (run: rustup target add $WINDOWS_TARGET, plus a mingw-w64 toolchain — Debian/Ubuntu: gcc-mingw-w64, Fedora: mingw64-gcc, Arch: mingw-w64-gcc, macOS: brew install mingw-w64)"
fi

CHANGED_RS=""
if [[ $SKIP_RUSTFMT -eq 0 ]]; then
    note "rustfmt --check on lines changed since $BASE_REF"
    CHANGED_RS=$(git diff --name-only "$BASE_REF"...HEAD -- '*.rs')
fi
if [[ $SKIP_RUSTFMT -eq 1 ]]; then
    skip "rustfmt (--skip-rustfmt)"
elif [[ -z $CHANGED_RS ]]; then
    skip "rustfmt (no changed .rs files vs $BASE_REF)"
else
    DIRTY=""
    DIRTY_FILES=()
    CHECKED=0
    APPLIED=0
    # Patch of just the in-hunk fixes, offered interactively at the end.
    FMT_PATCH="$LOG_DIR/preflight-rustfmt.patch"
    : > "$FMT_PATCH"
    while IFS= read -r f; do
        [[ -f $f ]] || continue
        CHECKED=$((CHECKED + 1))
        # rustfmt on stable walks `mod` children of whatever file you pass (no
        # stable equivalent to nightly's --skip-children exists), so checking
        # main.rs also re-reports drift in the modules it declares. Exit code
        # alone can't tell "this file is dirty" from "a child it declares via
        # `mod` is dirty" — match the reported path (which may be absolute, in
        # either separator style) against the file we actually asked about.
        # --color=never: this output is parsed (and re-emitted as a patch), so
        # it must not carry ANSI escapes; the display below colours it itself.
        diff_out=$(rustfmt --check --color=never --edition "$EDITION" "$f" 2>&1 || true)
        # shellcheck disable=SC1003  # escaped backslash for tr, not a quote typo
        flagged_lines=$(printf '%s\n' "$diff_out" | tr '\\' '/' | awk -v f="$f" '
      /^Diff in .*:[0-9]+:$/ {
        match($0, /:[0-9]+:$/)
        lineno = substr($0, RSTART + 1, RLENGTH - 2)
        path = substr($0, 9, RSTART - 9)
        if (path == f \
            || (length(path) > length(f) \
                && substr(path, length(path) - length(f) + 1) == f \
                && substr(path, length(path) - length(f), 1) == "/"))
          print lineno
      }')
        [[ -z $flagged_lines ]] && continue

        # A repo with no enforced formatting accumulates drift everywhere —
        # flagging a whole file on any diff anywhere in it would fail
        # permanently and drown out real regressions. Only count it dirty if a
        # flagged line falls inside a range this branch actually changed.
        #
        # rustfmt anchors a block at its leading context, up to 3 lines above
        # the first line it would actually reformat, so the reported line can
        # sit just outside the hunk while the real violation is inside it —
        # match the whole window (reported..reported+3) or those slip through
        # silently. Cost: drift starting within 3 lines of a hunk can now be
        # flagged; the apply prompt below makes that cheap to clear.
        ranges=$(git diff --unified=0 "$BASE_REF"...HEAD -- "$f" |
            sed -n -E 's/^@@ -[0-9]+(,[0-9]+)? \+([0-9]+)(,([0-9]+))? @@.*/\2 \4/p' |
            awk '{c = ($2 == "" ? 1 : $2); if (c > 0) print $1, c}')
        hits=""
        for line in $flagged_lines; do
            while read -r start count; do
                [[ -z $start ]] && continue
                if ((line + 3 >= start && line < start + count)); then
                    hits="${hits:+$hits }$line"
                    break
                fi
            done <<< "$ranges"
        done
        [[ -z $hits ]] && continue

        # Show what's actually wrong, right here: re-print only the `Diff in
        # <file>:<line>:` blocks whose line falls inside a changed hunk, so the
        # developer doesn't have to re-run rustfmt and sift pre-existing drift.
        pretty_lines="${hits// /, }"
        want_lines=",${hits// /,},"
        printf '\n\033[1;31m%s\033[0m: reformat needed on changed line(s) %s\n' \
            "$f" "$pretty_lines"
        # Same pass also re-emits those blocks as a unified diff (line counts
        # left to `git apply --recount`) so the fixes can be applied verbatim.
        printf -- '--- a/%s\n+++ b/%s\n' "$f" "$f" >> "$FMT_PATCH"
        printf '%s\n' "$diff_out" |
            awk -v f="$f" -v want="$want_lines" -v patch="$FMT_PATCH" '
      # rustfmt pads a block with trailing blank context that can run past EOF;
      # buffer each block and drop those before writing the hunk out.
      function flush(  i, last) {
        last = nbuf
        while (last > 0 && buf[last] ~ /^ *$/)
          last--
        if (last > 0) {
          print hunk >> patch
          for (i = 1; i <= last; i++)
            print buf[i] >> patch
        }
        nbuf = 0
      }
      /^Diff in .*:[0-9]+:$/ {
        flush()
        match($0, /:[0-9]+:$/)
        lineno = substr($0, RSTART + 1, RLENGTH - 2)
        path = substr($0, 9, RSTART - 9)
        gsub(/\\/, "/", path)
        show = ((path == f \
                 || (length(path) > length(f) \
                     && substr(path, length(path) - length(f) + 1) == f \
                     && substr(path, length(path) - length(f), 1) == "/")) \
                && index(want, "," lineno ",") > 0)
        if (show) {
          hunk = sprintf("@@ -%s,1 +%s,1 @@", lineno, lineno)
          print "    " $0
        }
        next
      }
      show {
        buf[++nbuf] = $0
        c = substr($0, 1, 1)
        if (c == "-") printf "    \033[31m%s\033[0m\n", $0
        else if (c == "+") printf "    \033[32m%s\033[0m\n", $0
        else print "    " $0
      }
      END { flush() }'
        DIRTY="${DIRTY:+$DIRTY; }$f (lines $pretty_lines)"
        DIRTY_FILES+=("$f")
    done <<< "$CHANGED_RS"
    if [[ -z $DIRTY ]]; then
        ok "rustfmt ($CHECKED file(s) checked)"
    else
        printf '\n\033[1mfix:\033[0m adjust the lines above (cargo fmt would reformat whole files incl. pre-existing drift — see README)\n'
        # Offer to apply exactly those blocks, then stage them, so the index
        # holds nothing but this fix and any unrelated work stays unstaged.
        # That needs an empty staging area, and the flagged files themselves
        # unmodified — the patch is generated against their on-disk content,
        # so local edits there could make it fail halfway. Dirt elsewhere in
        # the tree is none of this check's business.
        if [[ $APPLY_RUSTFMT -eq 0 && ! -t 0 ]]; then
            :
        elif ! git diff --cached --quiet; then
            printf 'Auto-apply unavailable: staging area is not empty — commit or unstage first.\n'
        elif ! git diff --quiet -- "${DIRTY_FILES[@]}"; then
            printf 'Auto-apply unavailable: local edits in %s — commit or stash those first.\n' \
                "$(git diff --name-only -- "${DIRTY_FILES[@]}" | tr '\n' ' ' | sed 's/ *$//')"
        else
            reply="y" # --apply-rustfmt: proceed as if the prompt was answered
            if [[ $APPLY_RUSTFMT -eq 0 ]]; then
                printf 'Apply just these fixes and stage them? [y/N] '
                read -r reply
            fi
            case "$reply" in
            [Yy]*)
                if git apply --recount "$FMT_PATCH" && git add -- "${DIRTY_FILES[@]}"; then
                    APPLIED=1
                    printf '\033[1;32mApplied and staged.\033[0m Review with: git diff --cached — then commit and re-run ./preflight\n'
                else
                    printf '\033[1;31mApply failed\033[0m — patch kept at %s; fix the lines by hand.\n' \
                        "$FMT_PATCH"
                fi
                ;;
            *)
                printf 'Left unchanged (patch: %s).\n' "$FMT_PATCH"
                ;;
            esac
        fi
        if [[ $APPLIED -eq 1 ]]; then
            fail "rustfmt: $DIRTY — fixes applied and staged, commit and re-run"
        else
            fail "rustfmt: $DIRTY"
        fi
    fi
fi

note "Leftover debug macros"
DEBUG_HITS=$(git diff "$BASE_REF"...HEAD -- '*.rs' |
    grep -E '^\+.*\b(dbg|todo|unimplemented)!' || true)
if [[ -z $DEBUG_HITS ]]; then
    ok "no added dbg!/todo!/unimplemented! lines"
elif [[ $ALLOW_DEBUG -eq 1 ]]; then
    echo "$DEBUG_HITS"
    skip "added debug macros (waved through via --allow-debug)"
else
    echo "Added lines contain debug macros:"
    echo "$DEBUG_HITS"
    echo "Rerun with --allow-debug if these are intentional."
    fail "added debug macros (see above)"
    if [[ -t 0 ]]; then
        printf 'Press any key to acknowledge (Ctrl-C to abort)...'
        read -r -n 1 -s
        echo
    fi
fi

note "Manual review reminder"
INTERP_HITS=$(git diff "$BASE_REF"...HEAD -- '*.rs' |
    grep -E '^\+.*(Command::new|cmd\.args|osascript|AppleScript)' || true)
if [[ -n $INTERP_HITS ]]; then
    echo "Changed lines touch an external interpreter (shell/cmd.exe/AppleScript)."
    echo "A clean compile says nothing about argv quoting — write out the exact"
    echo "string/argv the interpreter receives and check it by hand before pushing:"
    echo "$INTERP_HITS"
    skip "interpreter-string trace (manual — see above)"
else
    ok "no changed interpreter-invoking lines detected"
fi

if [[ $DO_REMOTE -eq 1 ]]; then
    note "Remote CI dispatch (full 3-OS coverage)"
    if ! command -v gh > /dev/null 2>&1; then
        fail "remote CI (gh CLI not installed — https://cli.github.com)"
    else
        BRANCH="preflight/$(git rev-parse --short HEAD)"
        git push origin "HEAD:refs/heads/$BRANCH" > /dev/null
        gh workflow run rust.yml --ref "$BRANCH"
        sleep 5
        RUN_ID=$(gh run list --workflow rust.yml --branch "$BRANCH" --limit 1 --json databaseId -q '.[0].databaseId')
        if gh run watch "$RUN_ID" --exit-status; then
            ok "remote CI (run $RUN_ID)"
        else
            fail "remote CI (run $RUN_ID)"
        fi
        if [[ $KEEP_BRANCH -eq 0 ]]; then
            git push origin --delete "$BRANCH" > /dev/null 2>&1 || true
        else
            echo "Kept scratch branch: $BRANCH"
        fi
    fi
fi

note "Summary"
printf '%s' "$SUMMARY"

if [[ $PASS -eq 1 ]]; then
    echo -e "\nAll checks passed."
    exit 0
else
    echo -e "\nOne or more checks failed."
    exit 1
fi
